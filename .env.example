# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Meta WhatsApp Cloud API ----
WHATSAPP_TOKEN=EAAxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_VERIFY_TOKEN=my-custom-verify-token

# ---- Mindbody API ----
MINDBODY_API_KEY=your-api-key
MINDBODY_SITE_ID=-99
MINDBODY_USERNAME=apiuser
MINDBODY_PASSWORD=apipass

# ---- OpenAI ----
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-4o

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Minutes a customer has to pay before the slot is released (Stripe minimum 31).
PAYMENT_TIMEOUT_MINUTES=31
# Journey total (in CENTS) at or above which EVERY treatment in the journey is
# billed upfront — including the ones normally paid at reception. Default
# 15000 = €150, so a €240 massage + LED + float is fully prepaid while a lone
# €80 float still settles at the desk.
JOURNEY_PREPAY_THRESHOLD_CENTS=15000

# ---- Email (SMTP) ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=welcome@renessence.com
SMTP_PASS=your-password
ESCALATION_EMAIL=welcome@renessence.com

# ---- Database ----
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Business Info ----
# Opening hours, closures, notices, address and contact emails are edited by
# the team in the dashboard ("Bot content"), stored in Postgres. SPA_ADDRESS is
# only a fallback if the knowledge base has no address; the rest is unused.
SPA_ADDRESS=

# ---- Dashboard ----
DASHBOARD_API_TOKEN=long-random-token
# Password for Settings → Stop/Resume bot
BOT_STOP_PASSWORD=change-me
# Password for editing "Bot content" (hours, closures, notices, contact).
# Without it nothing can be edited.
SETTINGS_EDIT_PASSWORD=change-me-too
